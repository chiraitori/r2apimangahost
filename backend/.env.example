# Server Configuration
PORT=8080
# Các frontend browser được phép gọi API, phân cách bằng dấu phẩy.
# Paperback là native client nên không cần thêm vào CORS.
ALLOWED_ORIGINS=http://localhost:5173,https://manga.yourdomain.com
# Chỉ bật khi origin backend được khóa sau Cloudflare/reverse proxy đáng tin cậy.
TRUST_PROXY_HEADERS=true

# MongoDB Connection
# Ví dụ local: mongodb://localhost:27017
# Ví dụ MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mangahost

# Cloudflare R2 Credentials (Lấy từ Cloudflare Dashboard -> R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mangahost
# Public Domain của bucket R2 (hoặc custom domain cdn)
# Ví dụ: https://pub-xxxxxxxxxxxxxx.r2.dev hoặc https://cdn.yourdomain.com
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxxxx.r2.dev

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_123456
JWT_SECRET=super_secret_jwt_key_please_change_in_production

# Rate Limiting Protection (Tự do tùy chỉnh)
# Giới hạn lượt đọc / lướt web (Mặc định: 300 requests/phút, Burst 60 request liên tiếp)
RATE_LIMIT_GENERAL_RPM=300
RATE_LIMIT_GENERAL_BURST=60
# Giới hạn thử đăng nhập admin (Mặc định: 20 lần/phút, Burst 10 lần liên tiếp)
RATE_LIMIT_LOGIN_RPM=20
RATE_LIMIT_LOGIN_BURST=10
# Giới hạn API admin sau khi đã xác thực
RATE_LIMIT_ADMIN_RPM=120
RATE_LIMIT_ADMIN_BURST=20
